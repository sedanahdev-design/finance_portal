# انسخ هذا الملف إلى .env وعدّل القيم قبل التشغيل في بيئة حقيقية.

# مفتاح Django السري — يجب تغييره لأي بيئة غير تطويرية (يمكن توليد واحد بالأمر:
# python3 -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=change-me-in-production

# اجعلها 0 في بيئة الإنتاج
DJANGO_DEBUG=0

# النطاقات/العناوين المسموح بها، مفصولة بفاصلة (مثال: example.com,10.0.0.5)
DJANGO_ALLOWED_HOSTS=*

# إلزامي عند النشر خلف نطاق حقيقي عبر Cloudflare أو أي بروكسي عكسي/نفق —
# بدونه ستفشل عملية تسجيل الدخول بخطأ "CSRF verification failed".
# ضع هنا الرابط الكامل (بالبروتوكول https) الذي يستخدمه المستخدمون فعلياً،
# مفصولاً بفاصلة إن وُجد أكثر من نطاق (مثال: https://portal.example.com,https://www.example.com)
DJANGO_CSRF_TRUSTED_ORIGINS=

# إعدادات قاعدة البيانات
DB_NAME=finance_portal
DB_USER=finance_admin
DB_PASSWORD=change-me-strong-password

# منفذ الويب المكشوف على الجهاز المضيف (غُيِّر عن 8000 الافتراضي لتفادي التعارض مع مشاريع أخرى)
WEB_PORT=8010

# إنشاء مستخدم مشرف تلقائياً عند أول تشغيل (اختياري، يمكن تركها فارغة
# وإنشاء المستخدم يدوياً لاحقاً عبر: docker compose exec web python3 manage.py createsuperuser)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@example.com
